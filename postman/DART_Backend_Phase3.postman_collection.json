{
  "info": {
    "name": "DART Backend — Phase 3 (Recon Security Management)",
    "description": "Covers every endpoint built in Phase 3: LOB/Team/Group/Role CRUD, admin/member management, Group↔Lob/Team/Role linking, the /groups/mine dropdown, and Recon↔Group linking. See Backend/docs/KT_PHASE3.md for the full write-up, including the Group.team_id schema correction this phase makes.\n\nSelf-contained like Phase 2's collection — logs in as the bootstrap admin itself to provision two fresh users. Set `base_url`, `bootstrap_admin_email`, `bootstrap_admin_password` in the accompanying environment file before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "token_a", "value": "" },
    { "key": "lob_id", "value": "" },
    { "key": "team_id", "value": "" },
    { "key": "group_id", "value": "" },
    { "key": "role_id", "value": "" },
    { "key": "recon_id", "value": "" },
    { "key": "user_a_id", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as bootstrap admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bootstrap_admin_email}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user A (as bootstrap admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"security-a@dart.com\",\n  \"username\": \"security_a\",\n  \"password\": \"SecurityUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"security-a@dart.com\",\n  \"password\": \"SecurityUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_a', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User A's id (as A)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('user_a_id', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "LOBs",
      "item": [
        {
          "name": "Create LOB — non-admin (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/lobs",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Should Fail\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Create LOB (as admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/lobs",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Finance\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('lob_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create LOB — duplicate name (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/lobs",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Finance\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "List LOBs (any authenticated user)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/lobs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200 OK — reads are not privilege-gated', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Add User A as LOB member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/lobs/{{lob_id}}/members",
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{user_a_id}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "List LOB members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/lobs/{{lob_id}}/members"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, includes security_a', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.include('security_a');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "Create team under LOB",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Payroll\",\n  \"lob_id\": \"{{lob_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('lob_name resolved', () => pm.expect(pm.response.json().lob_name).to.eql('Finance'));",
                  "pm.collectionVariables.set('team_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create team — nonexistent LOB (expect 404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ghost\",\n  \"lob_id\": \"00000000-0000-0000-0000-000000000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        },
        {
          "name": "List teams filtered by LOB",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/teams?lob_id={{lob_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "teams"],
              "query": [{ "key": "lob_id", "value": "{{lob_id}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create group (standalone — no parent required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/groups",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Recon Team A\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('group_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Link group to LOB",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/groups/{{group_id}}/lobs/{{lob_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Link group to Team",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/groups/{{group_id}}/teams/{{team_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Add User A as group member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/groups/{{group_id}}/members",
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{user_a_id}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Get group details — lob_names/team_names are arrays",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/groups/{{group_id}}/details"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('lob_names includes Finance', () => pm.expect(body.lob_names).to.include('Finance'));",
                  "pm.test('team_names includes Payroll', () => pm.expect(body.team_names).to.include('Payroll'));",
                  "pm.test('member_names includes security_a', () => pm.expect(body.member_names).to.include('security_a'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Groups mine (as User A) — the recon-creation dropdown contract",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/groups/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, includes Recon Team A', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const names = pm.response.json().map(g => g.name);",
                  "  pm.expect(names).to.include('Recon Team A');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Create role with unknown privilege (expect 400, not silent no-op)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ghost Role\",\n  \"privilege_names\": [\"not_a_real_privilege\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('code is unknown_privilege', () => pm.expect(pm.response.json().error.code).to.eql('unknown_privilege'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create role with real privileges",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Reviewer\",\n  \"privilege_names\": [\"read_recon\", \"sign_off_recon\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('role_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Link role to group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/groups/{{group_id}}/roles/{{role_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Group details now shows the role",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/groups/{{group_id}}/details"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('role_names includes Reviewer', () => pm.expect(pm.response.json().role_names).to.include('Reviewer'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recon ↔ Group linking",
      "item": [
        {
          "name": "Create recon (as User A)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Security_Phase3_Recon\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('no group yet', () => pm.expect(pm.response.json().group_name).to.be.null);",
                  "pm.collectionVariables.set('recon_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Link recon to group — old backend's second create step",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/groups/{{group_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('group_name now set', () => pm.expect(pm.response.json().group_name).to.eql('Recon Team A'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Link recon to nonexistent group (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/groups/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        },
        {
          "name": "Unlink recon from group",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/groups/{{group_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('group_name cleared', () => pm.expect(pm.response.json().group_name).to.be.null);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
