{
  "info": {
    "name": "DART Backend — Phase 1 (Identity & Auth)",
    "description": "Covers every endpoint built in Phase 1: health checks, real authentication (login/token/refresh), and privilege-gated user management. See Backend/docs/KT_PHASE1.md for the full write-up.\n\nRun order for a clean walkthrough: Health > Login as bootstrap admin > Me > Create a user > List users (as admin) > Login as that new user > Me (as new user) > List users (as new user, expect 403) > Refresh.\n\nSet `base_url`, `bootstrap_admin_email`, `bootstrap_admin_password` in the accompanying environment file before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "created_user_email", "value": "" },
    { "key": "created_user_password", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detailed (Postgres + Redis)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/health/detailed"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (bootstrap admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bootstrap_admin_email}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has access_token', () => pm.expect(body.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('access_token', body.access_token);",
                  "pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bootstrap_admin_email}}\",\n  \"password\": \"definitely-wrong\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('generic error code', () => pm.expect(pm.response.json().error.code).to.eql('invalid_credentials'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token (OAuth2 form — Swagger-compatible)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/api/v1/auth/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{bootstrap_admin_email}}" },
                { "key": "password", "value": "{{bootstrap_admin_password}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.access_token);",
                  "pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh — using an access token (expect 401, type confusion rejected)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{access_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('never returns hashed_password', () => pm.expect(pm.response.text()).to.not.include('hashed_password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me — no token (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('code is not_authenticated', () => pm.expect(pm.response.json().error.code).to.eql('not_authenticated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user (as admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@dart.com\",\n  \"username\": \"analyst1\",\n  \"password\": \"AnalystPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('created_user_email', 'analyst@dart.com');",
                  "pm.collectionVariables.set('created_user_password', 'AnalystPass123!');"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user — duplicate email (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@dart.com\",\n  \"username\": \"someone-else\",\n  \"password\": \"AnotherPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user — weak password (expect 422, not 500)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"weak@dart.com\",\n  \"username\": \"weakuser\",\n  \"password\": \"123456789012\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422 not 500 — regression check', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "List users (as admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/users?page=1&page_size=25",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "25" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as new user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{created_user_email}}\",\n  \"password\": \"{{created_user_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users (as new user — expect 403, no privilege)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('code is permission_denied', () => pm.expect(pm.response.json().error.code).to.eql('permission_denied'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
