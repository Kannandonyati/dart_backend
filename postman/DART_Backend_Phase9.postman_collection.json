{
  "info": {
    "name": "DART Backend — Phase 9 (Audit Logs & Maintenance)",
    "description": "Covers every endpoint built in Phase 9: audit-log reads (global/superuser, mine, per-recon, CSV export) and user maintenance (invite, accept-invite, admin-mediated password reset, list-invited, deactivate). See Backend/docs/KT_PHASE9.md for the full write-up, including why password reset is admin-mediated rather than self-service email.\n\nNo Celery worker or Redis needed — every Phase 9 endpoint is synchronous. Self-contained like Phase 2-8's collections. Set `base_url`, `bootstrap_admin_email`, `bootstrap_admin_password` in the accompanying environment file before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "token_a", "value": "" },
    { "key": "token_b", "value": "" },
    { "key": "recon_id", "value": "" },
    { "key": "invite_token", "value": "" },
    { "key": "invited_user_id", "value": "" },
    { "key": "reset_token", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as bootstrap admin (superuser)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bootstrap_admin_email}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);",
                  "pm.collectionVariables.set('login_rate_window_start', Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user B (plain, non-privileged)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"audit-b@dart.com\",\n  \"username\": \"audit_b\",\n  \"password\": \"AuditUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"audit-b@dart.com\",\n  \"password\": \"AuditUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_b', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create recon as admin (generates a recon.created audit row)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/recons",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phase9_Test_Recon\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('recon_id', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "Global audit log requires superuser (User B gets 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/api/v1/audit-logs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Global audit log (bootstrap admin, superuser)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/audit-logs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, includes the recon.created row', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const actions = pm.response.json().map(e => e.action);",
                  "  pm.expect(actions).to.include('recon.created');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Recon-scoped audit log",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/audit-logs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, one row for this recon', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().length).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "User B cannot see admin's recon audit log (expect 404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/audit-logs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        },
        {
          "name": "My audit log (User B sees only their own actions)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/api/v1/audit-logs/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Export audit log as CSV (superuser)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/audit-logs/export"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, CSV content', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
                  "  pm.expect(pm.response.text()).to.include('recon.created');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User Maintenance",
      "item": [
        {
          "name": "Invite requires user:manage (User B gets 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_b}}" }
            ],
            "url": "{{base_url}}/api/v1/users/invite",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"blocked-invite@dart.com\",\n  \"username\": \"blockedinvite\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Invite a new user (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users/invite",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase9-invitee@dart.com\",\n  \"username\": \"phase9invitee\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created, inactive until accepted', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('invite_token', body.invite_token);",
                  "pm.collectionVariables.set('invited_user_id', body.user_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Invited user cannot log in yet",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase9-invitee@dart.com\",\n  \"password\": \"whatever\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "List invited (pending) users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/users/invited"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, includes the invitee', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const emails = pm.response.json().map(u => u.email);",
                  "  pm.expect(emails).to.include('phase9-invitee@dart.com');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept invite (sets password, activates)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/users/accept-invite",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_token\": \"{{invite_token}}\",\n  \"password\": \"InviteeRealPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, now active', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().is_active).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invited user can now log in",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase9-invitee@dart.com\",\n  \"password\": \"InviteeRealPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Reject an invalid invite token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/users/accept-invite",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_token\": \"not-a-real-token\",\n  \"password\": \"SomePassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Admin generates a password-reset token for the invitee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/users/{{invited_user_id}}/reset-token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('reset_token', pm.response.json().reset_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit password reset with that token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/users/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reset_token\": \"{{reset_token}}\",\n  \"new_password\": \"BrandNewInviteePass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Old password no longer works",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase9-invitee@dart.com\",\n  \"password\": \"InviteeRealPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Wait for /auth/login rate-limit window to reset",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Phase 1's login endpoint is rate-limited to 5/minute (see auth.py).",
                  "// This collection makes 7 /auth/login calls total; without this wait",
                  "// the 6th/7th land in the same 60s window and get 429 instead of the",
                  "// real status this collection is asserting -- same class of issue",
                  "// Phase 5/6's KTs document for Run Import/Bridge Run polling, applied",
                  "// here to a rate limiter instead of an async job.",
                  "const start = parseInt(pm.collectionVariables.get('login_rate_window_start'));",
                  "const elapsed = Date.now() - start;",
                  "if (elapsed < 61000) {",
                  "  setTimeout(() => {}, 3000);",
                  "  postman.setNextRequest('Wait for /auth/login rate-limit window to reset');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "New password works",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase9-invitee@dart.com\",\n  \"password\": \"BrandNewInviteePass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Admin deactivates the invitee",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/users/{{invited_user_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Deactivated user can no longer log in",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase9-invitee@dart.com\",\n  \"password\": \"BrandNewInviteePass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
