{
  "info": {
    "name": "DART Backend — Phase 4 (Dimension Linking)",
    "description": "Covers every endpoint built in Phase 4: Recon App CRUD, Dimension CRUD, mandatory-dimension seeding, reorder, and CSV export/import. See Backend/docs/KT_PHASE4.md for the full write-up.\n\nSelf-contained like Phase 2/3's collections. Set `base_url`, `bootstrap_admin_email`, `bootstrap_admin_password` in the accompanying environment file before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "token_a", "value": "" },
    { "key": "token_b", "value": "" },
    { "key": "recon_id", "value": "" },
    { "key": "dimension_id", "value": "" },
    { "key": "dim_a_id", "value": "" },
    { "key": "dim_b_id", "value": "" },
    { "key": "dim_c_id", "value": "" },
    { "key": "dim_d_id", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as bootstrap admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bootstrap_admin_email}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dim-a@dart.com\",\n  \"username\": \"dim_a\",\n  \"password\": \"DimUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dim-a@dart.com\",\n  \"password\": \"DimUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_a', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create recon",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phase4_Test_Recon\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('recon_id', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recon Apps",
      "item": [
        {
          "name": "Create App1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_number\": 1,\n  \"name\": \"General Ledger\",\n  \"delimiter\": \",\",\n  \"has_header\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create App2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_number\": 2,\n  \"name\": \"Sub-ledger\",\n  \"delimiter\": \";\",\n  \"has_header\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create App — invalid app_number 3 (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps",
            "body": { "mode": "raw", "raw": "{\n  \"app_number\": 3,\n  \"name\": \"Ghost\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('422 Unprocessable', () => pm.response.to.have.status(422));"]
              }
            }
          ]
        },
        {
          "name": "List apps",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, two apps', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().length).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update App1 delimiter",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps/1",
            "body": { "mode": "raw", "raw": "{\n  \"delimiter\": \"|\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('delimiter updated', () => pm.expect(pm.response.json().delimiter).to.eql('|'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mandatory Dimensions",
      "item": [
        {
          "name": "Seed mandatory dimensions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions/seed-mandatory"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const names = pm.response.json().map(d => d.name);",
                  "pm.test('YEAR, PERIOD, AMOUNT in order', () => pm.expect(names).to.eql(['YEAR', 'PERIOD', 'AMOUNT']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Seed again — idempotent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions/seed-mandatory"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, still exactly 3', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().length).to.eql(3);",
                  "});",
                  "const year = pm.response.json().find(d => d.name === 'YEAR');",
                  "pm.collectionVariables.set('dimension_id', year.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete YEAR — mandatory, expect 400",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions/{{dimension_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('code is mandatory_dimension', () => pm.expect(pm.response.json().error.code).to.eql('mandatory_dimension'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Custom Dimensions",
      "item": [
        {
          "name": "Create dimension A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"account\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"A\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"B\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('name uppercased', () => pm.expect(pm.response.json().name).to.eql('ACCOUNT'));",
                  "pm.collectionVariables.set('dim_a_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create dimension — mismatched app numbers (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BROKEN\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"A\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('422 Unprocessable', () => pm.response.to.have.status(422));"]
              }
            }
          ]
        },
        {
          "name": "Duplicate dimension name (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ACCOUNT\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"C\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"D\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension B/C/D (for reorder test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"REGION\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"E\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"F\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('dim_b_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reorder REGION to position 0",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions/{{dim_b_id}}/reorder",
            "body": { "mode": "raw", "raw": "{\n  \"new_position\": 0\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const region = pm.response.json().find(d => d.id === pm.collectionVariables.get('dim_b_id'));",
                  "pm.test('REGION now at position 0', () => pm.expect(region.position).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Export dimensions CSV",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions/export"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, CSV', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete ACCOUNT dimension",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions/{{dim_a_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Access control",
      "item": [
        {
          "name": "Create user B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dim-b@dart.com\",\n  \"username\": \"dim_b\",\n  \"password\": \"DimUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dim-b@dart.com\",\n  \"password\": \"DimUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_b', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "User B cannot see User A's dimensions (expect 404, not 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
