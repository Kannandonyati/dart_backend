{
  "info": {
    "name": "DART Backend — Phase 7 (Transformation)",
    "description": "Covers every endpoint built in Phase 7: sync mapping CRUD, possible-combinations candidate generation, and the synchronous sync-data run (no Celery task — see Backend/docs/KT_PHASE7.md for why). Setup still needs a completed Run Import, so a live Celery worker + Redis is required exactly as in Phase 5/6.\n\nSelf-contained like Phase 2-6's collections. Set `base_url`, `bootstrap_admin_email`, `bootstrap_admin_password` in the accompanying environment file before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "token_a", "value": "" },
    { "key": "token_b", "value": "" },
    { "key": "recon_id", "value": "" },
    { "key": "import_run_id", "value": "" },
    { "key": "import_poll_attempt", "value": "" },
    { "key": "sync_mapping_id", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as bootstrap admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bootstrap_admin_email}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sync-a@dart.com\",\n  \"username\": \"sync_a\",\n  \"password\": \"SyncUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sync-a@dart.com\",\n  \"password\": \"SyncUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_a', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create recon",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phase7_Test_Recon\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('recon_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create App1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps",
            "body": { "mode": "raw", "raw": "{\n  \"app_number\": 1,\n  \"name\": \"GL\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create App2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps",
            "body": { "mode": "raw", "raw": "{\n  \"app_number\": 2,\n  \"name\": \"Sub\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension YEAR (both apps, col 1)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"YEAR\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"1\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"1\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension ACCOUNT (both apps, col 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ACCOUNT\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"2\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"2\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension COST_CENTER (both apps, col 3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"COST_CENTER\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"3\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"3\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension AMOUNT (both apps, col 4)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AMOUNT\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"4\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"4\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Import App1 data",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "app_number", "value": "1", "type": "text" },
                { "key": "file", "type": "file", "src": "fixtures/sync_import.csv" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('import_run_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll import run until completed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports/{{import_run_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const attempt = pm.collectionVariables.get('import_poll_attempt') ? parseInt(pm.collectionVariables.get('import_poll_attempt')) : 0;",
                  "if (body.status === 'pending' || body.status === 'processing') {",
                  "  if (attempt < 20) {",
                  "    pm.collectionVariables.set('import_poll_attempt', attempt + 1);",
                  "    setTimeout(() => {}, 3000);",
                  "    postman.setNextRequest('Poll import run until completed');",
                  "    return;",
                  "  }",
                  "  throw new Error('Import run still ' + body.status + ' after 20 polls — is a Celery worker running?');",
                  "}",
                  "pm.collectionVariables.unset('import_poll_attempt');",
                  "pm.test('completed', () => pm.expect(body.status).to.eql('completed'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sync Mappings",
      "item": [
        {
          "name": "Create simple mapping (ACCOUNT 1000 -> CASH)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-mappings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_number\": 1,\n  \"dimension_names\": [\"ACCOUNT\"],\n  \"source_sync\": \"1000\",\n  \"target_sync\": \"CASH\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('concat_delimiter defaults to -', () => pm.expect(pm.response.json().concat_delimiter).to.eql('-'));",
                  "pm.collectionVariables.set('sync_mapping_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create concat mapping (ACCOUNT|COST_CENTER -> CASH_CC1)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-mappings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_number\": 1,\n  \"dimension_names\": [\"ACCOUNT\", \"COST_CENTER\"],\n  \"concat_delimiter\": \"|\",\n  \"source_sync\": \"1000|CC1\",\n  \"target_sync\": \"CASH_CC1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('dimension_names preserved in order', () => pm.expect(pm.response.json().dimension_names).to.eql(['ACCOUNT', 'COST_CENTER']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create mapping for AMOUNT (expect 400, not syncable)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-mappings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_number\": 1,\n  \"dimension_names\": [\"AMOUNT\"],\n  \"source_sync\": \"100\",\n  \"target_sync\": \"X\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('code is not_syncable', () => pm.expect(pm.response.json().error.code).to.eql('not_syncable'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate mapping key (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-mappings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_number\": 1,\n  \"dimension_names\": [\"ACCOUNT\"],\n  \"source_sync\": \"1000\",\n  \"target_sync\": \"CASH\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "List sync mappings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-mappings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, two mappings', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().length).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Possible combinations for ACCOUNT+COST_CENTER (zip, not product)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-mappings/possible-combinations?app_number=1&dimension_names=ACCOUNT&dimension_names=COST_CENTER"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const combos = pm.response.json();",
                  "pm.test('2 combos (zip), not 4 (product)', () => {",
                  "  pm.expect(combos.length).to.eql(2);",
                  "  combos.forEach(c => pm.expect(c.length).to.eql(2));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update mapping (flip_sign)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-mappings/{{sync_mapping_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_sync\": \"CASH_V2\",\n  \"flip_sign\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('updated fields applied', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.target_sync).to.eql('CASH_V2');",
                  "  pm.expect(body.flip_sign).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sync Data",
      "item": [
        {
          "name": "Run transformation (resolved synced values)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-data/run?app_number=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, two rows', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().length).to.eql(2);",
                  "});",
                  "const rows = pm.response.json();",
                  "const mapped = rows.find(r => r.data.ACCOUNT === '1000');",
                  "const unmapped = rows.find(r => r.data.ACCOUNT === '2000');",
                  "pm.test('mapped row has ACCOUNT-COST_CENTER synced (concat mapping wins)', () => {",
                  "  pm.expect(mapped.synced).to.have.property('ACCOUNT-COST_CENTER', 'CASH_CC1');",
                  "  pm.expect(mapped.synced).to.have.property('ACCOUNT', 'CASH_V2');",
                  "});",
                  "pm.test('unmapped row has no synced values', () => {",
                  "  pm.expect(unmapped.synced).to.eql({});",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Access control",
      "item": [
        {
          "name": "Create user B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sync-b@dart.com\",\n  \"username\": \"sync_b\",\n  \"password\": \"SyncUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sync-b@dart.com\",\n  \"password\": \"SyncUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_b', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "User B cannot see User A's sync mappings (expect 404, not 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-mappings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        },
        {
          "name": "User B cannot run transformation (expect 404, not 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/sync-data/run"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
