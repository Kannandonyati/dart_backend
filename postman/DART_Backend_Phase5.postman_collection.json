{
  "info": {
    "name": "DART Backend — Phase 5 (Run Import)",
    "description": "Covers every endpoint built in Phase 5: file upload (enqueues a Celery task), import-run history, status polling, and reading back imported rows. See Backend/docs/KT_PHASE5.md for the full write-up.\n\n**Requires a running Celery worker** consuming the same Redis broker as `base_url`'s backend — otherwise uploads stay `pending` forever and the polling steps below will fail. Start one with:\n`uv run celery -A app.tasks.celery_app worker --pool=solo --loglevel=info` (the `--pool=solo` flag is Windows-specific; drop it on Linux/macOS).\n\nThe upload requests attach `postman/fixtures/sample_import.csv` (checked into this repo) — run Newman from the `Backend/` directory so the relative path resolves, with `--insecure-file-read`.\n\nSelf-contained like Phase 2-4's collections. Set `base_url`, `bootstrap_admin_email`, `bootstrap_admin_password` in the accompanying environment file before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "token_a", "value": "" },
    { "key": "token_b", "value": "" },
    { "key": "recon_id", "value": "" },
    { "key": "import_run_id", "value": "" },
    { "key": "poll_attempt", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as bootstrap admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bootstrap_admin_email}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"import-a@dart.com\",\n  \"username\": \"import_a\",\n  \"password\": \"ImportUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"import-a@dart.com\",\n  \"password\": \"ImportUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_a', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create recon",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phase5_Test_Recon\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('recon_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create App1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps",
            "body": { "mode": "raw", "raw": "{\n  \"app_number\": 1,\n  \"name\": \"GL\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension YEAR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"YEAR\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"1\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"1\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension AMOUNT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AMOUNT\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"2\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"2\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Run Import",
      "item": [
        {
          "name": "Upload to unconfigured app (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "app_number", "value": "2", "type": "text" },
                { "key": "file", "type": "file", "src": "fixtures/sample_import.csv" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        },
        {
          "name": "Upload sample file",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "app_number", "value": "1", "type": "text" },
                { "key": "file", "type": "file", "src": "fixtures/sample_import.csv" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('starts pending', () => pm.expect(body.status).to.eql('pending'));",
                  "pm.collectionVariables.set('import_run_id', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll status until completed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports/{{import_run_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const attempt = pm.collectionVariables.get('poll_attempt') ? parseInt(pm.collectionVariables.get('poll_attempt')) : 0;",
                  "if (body.status === 'pending' || body.status === 'processing') {",
                  "  if (attempt < 20) {",
                  "    pm.collectionVariables.set('poll_attempt', attempt + 1);",
                  "    setTimeout(() => {}, 3000);",
                  "    postman.setNextRequest('Poll status until completed');",
                  "    return;",
                  "  }",
                  "  throw new Error('Import run still ' + body.status + ' after 20 polls — is a Celery worker running and consuming this broker?');",
                  "}",
                  "pm.collectionVariables.unset('poll_attempt');",
                  "pm.test('completed with 2 rows', () => {",
                  "  pm.expect(body.status).to.eql('completed');",
                  "  pm.expect(body.row_count).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List import history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, includes the run just uploaded', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().map(r => r.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('import_run_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read imported data",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/recons/{{recon_id}}/imports/data?app_number=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "recons", "{{recon_id}}", "imports", "data"],
              "query": [{ "key": "app_number", "value": "1" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, two rows with dimension-keyed data', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const rows = pm.response.json();",
                  "  pm.expect(rows.length).to.eql(2);",
                  "  pm.expect(rows[0].data).to.eql({YEAR: '2024', AMOUNT: '100'});",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Access control",
      "item": [
        {
          "name": "Create user B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"import-b@dart.com\",\n  \"username\": \"import_b\",\n  \"password\": \"ImportUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"import-b@dart.com\",\n  \"password\": \"ImportUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_b', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "User B cannot see User A's import history (expect 404, not 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
