{
  "info": {
    "name": "DART Backend — Phase 8 (Run Report)",
    "description": "Covers every endpoint built in Phase 8: the reconciliation report run (bridge-resolved matching, variance, threshold), sign-off, saved report filters + member lookup, drill-down, CSV export, and last-refresh. See Backend/docs/KT_PHASE8.md for the full write-up, including why the variance formula is new-backend-defined rather than ported.\n\n**Requires a running Celery worker** for the Setup folder's two Run Imports, same as Phase 5-7. The bridge mapping that normalizes App2's `ACCT_A_ALT` to App1's `ACCT_A` is created directly (Bridge Members is synchronous to create/list, only the run itself needs a worker, and this collection doesn't need a bridge run — matching in `report/run` reads `BridgeMapping` rows directly).\n\nSelf-contained like Phase 2-7's collections. Set `base_url`, `bootstrap_admin_email`, `bootstrap_admin_password` in the accompanying environment file before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "token_a", "value": "" },
    { "key": "token_b", "value": "" },
    { "key": "recon_id", "value": "" },
    { "key": "import_run_1_id", "value": "" },
    { "key": "import_run_2_id", "value": "" },
    { "key": "import_poll_attempt_1", "value": "" },
    { "key": "import_poll_attempt_2", "value": "" },
    { "key": "report_filter_id", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as bootstrap admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bootstrap_admin_email}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"report-a@dart.com\",\n  \"username\": \"report_a\",\n  \"password\": \"ReportUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"report-a@dart.com\",\n  \"password\": \"ReportUserA123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_a', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create recon",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phase8_Test_Recon\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('recon_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create App1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps",
            "body": { "mode": "raw", "raw": "{\n  \"app_number\": 1,\n  \"name\": \"GL\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create App2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/apps",
            "body": { "mode": "raw", "raw": "{\n  \"app_number\": 2,\n  \"name\": \"Sub\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension YEAR (both apps, col 1)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"YEAR\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"1\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"1\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension ACCOUNT (both apps, col 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ACCOUNT\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"2\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"2\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create dimension AMOUNT (both apps, col 3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/dimensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AMOUNT\",\n  \"mappings\": [\n    {\"app_number\": 1, \"in_file\": true, \"column_location\": \"3\"},\n    {\"app_number\": 2, \"in_file\": true, \"column_location\": \"3\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Import App1 data",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "app_number", "value": "1", "type": "text" },
                { "key": "file", "type": "file", "src": "fixtures/report_app1.csv" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('import_run_1_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll App1 import run until completed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports/{{import_run_1_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const attempt = pm.collectionVariables.get('import_poll_attempt_1') ? parseInt(pm.collectionVariables.get('import_poll_attempt_1')) : 0;",
                  "if (body.status === 'pending' || body.status === 'processing') {",
                  "  if (attempt < 20) {",
                  "    pm.collectionVariables.set('import_poll_attempt_1', attempt + 1);",
                  "    setTimeout(() => {}, 3000);",
                  "    postman.setNextRequest('Poll App1 import run until completed');",
                  "    return;",
                  "  }",
                  "  throw new Error('App1 import run still ' + body.status + ' after 20 polls — is a Celery worker running?');",
                  "}",
                  "pm.collectionVariables.unset('import_poll_attempt_1');",
                  "pm.test('completed', () => pm.expect(body.status).to.eql('completed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Import App2 data",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "app_number", "value": "2", "type": "text" },
                { "key": "file", "type": "file", "src": "fixtures/report_app2.csv" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('import_run_2_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll App2 import run until completed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/imports/{{import_run_2_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const attempt = pm.collectionVariables.get('import_poll_attempt_2') ? parseInt(pm.collectionVariables.get('import_poll_attempt_2')) : 0;",
                  "if (body.status === 'pending' || body.status === 'processing') {",
                  "  if (attempt < 20) {",
                  "    pm.collectionVariables.set('import_poll_attempt_2', attempt + 1);",
                  "    setTimeout(() => {}, 3000);",
                  "    postman.setNextRequest('Poll App2 import run until completed');",
                  "    return;",
                  "  }",
                  "  throw new Error('App2 import run still ' + body.status + ' after 20 polls — is a Celery worker running?');",
                  "}",
                  "pm.collectionVariables.unset('import_poll_attempt_2');",
                  "pm.test('completed', () => pm.expect(body.status).to.eql('completed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bridge map App1 ACCT_A -> ACCT_A (identity)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/bridge-mappings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_number\": 1,\n  \"dimension_name\": \"ACCOUNT\",\n  \"source_member\": \"ACCT_A\",\n  \"bridge_member\": \"ACCT_A\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Bridge map App2 ACCT_A_ALT -> ACCT_A (normalize)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/bridge-mappings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_number\": 2,\n  \"dimension_name\": \"ACCOUNT\",\n  \"source_member\": \"ACCT_A_ALT\",\n  \"bridge_member\": \"ACCT_A\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Run Report",
      "item": [
        {
          "name": "Run report (bridge-resolved matching)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/run"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('3 matched rows, 2 with variance', () => {",
                  "  pm.expect(body.summary.total_rows).to.eql(3);",
                  "  pm.expect(body.summary.variance_count).to.eql(2);",
                  "});",
                  "const acctA = body.rows.find(r => r.match_key.ACCOUNT === 'ACCT_A');",
                  "pm.test('ACCT_A matched across apps via bridge, no variance', () => {",
                  "  pm.expect(acctA.app1_amount).to.eql('100.00');",
                  "  pm.expect(acctA.app2_amount).to.eql('100.00');",
                  "  pm.expect(acctA.is_variance).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Run report with variance_threshold=50 (suppresses small diffs)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/run?variance_threshold=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, no rows exceed threshold', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().summary.variance_count).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Drill down to ACCT_B",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/drill-down?dimension_names=YEAR&dimension_names=ACCOUNT&values=2024&values=ACCT_B"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, exactly one row', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().length).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Export report as CSV",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/export"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, CSV content', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
                  "  pm.expect(pm.response.text()).to.include('ACCT_B');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Last refresh timestamps",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/last-refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, both apps have a refresh time', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.find(r => r.app_number === 1).last_refresh).to.not.be.null;",
                  "  pm.expect(body.find(r => r.app_number === 2).last_refresh).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Report Filters",
      "item": [
        {
          "name": "Create filter (Only ACCT_A)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/filters",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Only ACCT_A\",\n  \"criteria\": {\"ACCOUNT\": [\"ACCT_A\", \"ACCT_A_ALT\"]}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('report_filter_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Run report with the saved filter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/run?filter_id={{report_filter_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, only the filtered row', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.summary.total_rows).to.eql(1);",
                  "  pm.expect(body.rows[0].match_key.ACCOUNT).to.eql('ACCT_A');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List filter members for ACCOUNT",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/filters/members?dimension_name=ACCOUNT"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, includes both apps distinct values', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const members = pm.response.json();",
                  "  pm.expect(members).to.include('ACCT_A');",
                  "  pm.expect(members).to.include('ACCT_A_ALT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate filter name (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/filters",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Only ACCT_A\",\n  \"criteria\": {\"ACCOUNT\": [\"ACCT_A\"]}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "Update filter criteria",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/filters/{{report_filter_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criteria\": {\"ACCOUNT\": [\"ACCT_B\"]}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, criteria updated', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().criteria.ACCOUNT).to.eql(['ACCT_B']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete filter",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/filters/{{report_filter_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sign-off",
      "item": [
        {
          "name": "Sign off both apps",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/signoff",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_numbers\": [1, 2],\n  \"signed_off\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, both signed off', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.json().forEach(r => pm.expect(r.signed_off).to.be.true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List sign-offs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/signoff"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK, two signoff rows', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().length).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Access control",
      "item": [
        {
          "name": "Create user B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"report-b@dart.com\",\n  \"username\": \"report_b\",\n  \"password\": \"ReportUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"report-b@dart.com\",\n  \"password\": \"ReportUserB123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_b', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "User B cannot run User A's report (expect 404, not 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/api/v1/recons/{{recon_id}}/report/run"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    }
  ]
