# Copy to .env for local development. Never commit the real .env.
# In staging/production, set these as real environment variables /
# secrets-manager entries — do not ship a .env file to those environments.

ENVIRONMENT=local
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=1

# Comma-separated, explicit — never "*"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql+asyncpg://dart:your-password-here@localhost:5432/dart
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=300

CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

RATE_LIMIT_DEFAULT=100/minute

# SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false

# Bootstrap admin — only used by `uv run python -m app.db.seed`, to
# create the first break-glass account. Leave unset day-to-day; set
# temporarily only when actually running the seed script, with a real
# password, never committed. recon@admin.com matches the old backend's
# naming convention for this account; the password is yours to set — the
# old system's actual credentials lived only in a deployed database this
# rebuild has no access to, so nothing here is "recovered," only renamed
# to match.
# BOOTSTRAP_ADMIN_EMAIL=recon@admin.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional second bootstrap account — also a full break-glass superuser,
# not an ordinary one (confirmed against the live reference system's
# Manage Users screen: "Default Admin"/default@dart.com holds every
# role there). Mirrors the old backend's default@dart.com convention.
# Skipped entirely by the seed script if either value is left unset.
# DEFAULT_USER_EMAIL=default@dart.com
# DEFAULT_USER_PASSWORD=

# Platform admin — the tier above both accounts above. Only this
# account can change which UI components everyone else may see, and
# this file is the only way to confer the tier (no API can set it).
# Skipped entirely by the seed script if either value is left unset.
# PLATFORM_ADMIN_EMAIL=dartsuper@admin.com
# PLATFORM_ADMIN_PASSWORD=
